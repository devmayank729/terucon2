+  if (typeof i.fit.confidence !== "number" || Number.isNaN(i.fit.confidence) || i.fit.confidence < low) {
+    return {
+      code: "weak-fit",
+      text: "The 3D fit for this surface is too uncertain for an instant preview. Use Render to see the finish.",
+    };
+  }
+  return null;
+}
