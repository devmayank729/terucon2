{
  "_comment": "Patches for the Materials shop (pages_original/market_place.html). Format: site/patches/README.md",
  "page": "materials",
  "steps": [
    {
      "id": "relink",
      "op": "relink",
      "why": "rewrite the design-time file names to the pages of the site",
      "expect": 18
    },
    {
      "id": "header-project",
      "op": "insertAfter",
      "why": "header: My project link",
      "anchor": "Saved<span style=\"font:400 12px/1 Switzer,sans-serif;opacity:.7\">{{ savedN }}</span></a>",
      "insert": [
        "\n      ",
        "\n      ",
        {
          "component": "headerLink",
          "entry": "project"
        },
        "\n      ",
        {
          "component": "accountLink",
          "entry": "account"
        }
      ]
    },
    {
      "id": "menu-project",
      "op": "insertAfter",
      "why": "menu: My project card",
      "anchor": "Upload a photo of your space and see it in Terucon materials.</span></a>",
      "insert": [
        "\n        ",
        {
          "component": "menuCard",
          "entry": "project"
        },
        "\n        ",
        {
          "component": "menuCard",
          "entry": "account"
        }
      ]
    },
    {
      "id": "footer-project",
      "op": "insertAfter",
      "why": "footer: My project link",
      "anchor": "style-hover=\"color:#FFFFFF\">Design Studio</a>",
      "insert": [
        {
          "component": "footerLink",
          "entry": "project"
        }
      ]
    },
    {
      "id": "header-inspiration",
      "op": "insertAfter",
      "why": "header: Inspiration link",
      "anchor": "Saved<span style=\"font:400 12px/1 Switzer,sans-serif;opacity:.7\">{{ savedN }}</span></a>",
      "insert": [
        "\n      ",
        {
          "component": "headerLink",
          "entry": "inspiration"
        }
      ]
    },
    {
      "id": "header-finder",
      "op": "insertAfter",
      "why": "header: Finder link",
      "anchor": "Saved<span style=\"font:400 12px/1 Switzer,sans-serif;opacity:.7\">{{ savedN }}</span></a>",
      "insert": [
        "\n      ",
        {
          "component": "headerLink",
          "entry": "finder"
        }
      ]
    },
    {
      "id": "menu-inspiration",
      "op": "insertAfter",
      "why": "menu: Inspiration card",
      "anchor": "Upload a photo of your space and see it in Terucon materials.</span></a>",
      "insert": [
        "\n        ",
        {
          "component": "menuCard",
          "entry": "inspiration"
        }
      ]
    },
    {
      "id": "menu-finder",
      "op": "insertAfter",
      "why": "menu: Finder card",
      "anchor": "Upload a photo of your space and see it in Terucon materials.</span></a>",
      "insert": [
        "\n        ",
        {
          "component": "menuCard",
          "entry": "finder"
        }
      ]
    },
    {
      "id": "footer-inspiration",
      "op": "insertAfter",
      "why": "footer: Inspiration link",
      "anchor": "style-hover=\"color:#FFFFFF\">Design Studio</a>",
      "insert": [
        {
          "component": "footerLink",
          "entry": "inspiration"
        }
      ]
    },
    {
      "id": "footer-finder",
      "op": "insertAfter",
      "why": "footer: Finder link",
      "anchor": "style-hover=\"color:#FFFFFF\">Design Studio</a>",
      "insert": [
        {
          "component": "footerLink",
          "entry": "finder"
        }
      ]
    },
    {
      "id": "media-guides-off",
      "op": "replace",
      "why": "hide the design-review media pill (its target file does not exist)",
      "anchor": "&quot;mediaGuides&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true",
      "with": "&quot;mediaGuides&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:false"
    },
    {
      "id": "media-pill-retarget",
      "op": "replace",
      "why": "retarget the hidden media pill (no dead link left in the page)",
      "anchor": "<a href=\"Materials%20Media%20Brief.dc.html\"",
      "with": "<a href=\"#\""
    },
    {
      "id": "analytics",
      "op": "insertBefore",
      "why": "PostHog analytics: page views, clicks and forms, and (studio page) the studio's own events, which its browser code sends to window.posthog but its server never gives a key for. The script asks GET /api/analytics, so no key is in the page",
      "anchor": "</helmet>",
      "insert": [
        "<script>",
        {
          "file": "snippets/analytics.js",
          "chomp": true
        },
        "</script>\n"
      ]
    },
    {
      "id": "auth",
      "op": "insertBefore",
      "why": "sign-in: the header link says Sign in or Account, and a request answered \"please sign in\" (the session ended) leads to the sign-in page. The script asks GET /api/auth/me, so nothing about the visitor is in the page",
      "anchor": "</helmet>",
      "insert": [
        "<script>",
        {
          "file": "snippets/auth.js",
          "chomp": true
        },
        "</script>\n"
      ]
    },
    {
      "id": "import-script",
      "op": "insertBefore",
      "why": "paste an address into a box marked data-import-urls and it asks \"Import this photo?\" (target C3). The script is a module served from /inspiration/assets/ (server/routes/inspiration.js), not inline text, so this page's runtime never rewrites it",
      "anchor": "</helmet>",
      "insert": [
        "<script type=\"module\" src=\"/inspiration/assets/index.js\"></script>\n"
      ]
    },
    {
      "id": "import-search-box",
      "op": "replace",
      "why": "the shop's search box takes a pasted photo address (data-import-urls, see import-script)",
      "anchor": "<input ref=\"{{ srch.ref }}\"",
      "with": "<input data-import-urls=\"\" ref=\"{{ srch.ref }}\""
    },
    {
      "id": "import-assistant-box",
      "op": "replace",
      "why": "the shop assistant's box takes a pasted photo address (data-import-urls, see import-script)",
      "anchor": "<input ref=\"{{ va.inRef }}\"",
      "with": "<input data-import-urls=\"\" ref=\"{{ va.inRef }}\""
    },
    {
      "id": "photo-match-finder-banner",
      "op": "insertAfter",
      "why": "the shop's own photo-match card is a frontend preview (TARGETS.md A1/C4); this points to the Finder, which actually searches the real catalogue (target C4)",
      "anchor": "<div style=\"flex:1;min-height:0;overflow:auto;overscroll-behavior:contain;padding:22px 24px\">",
      "insert": [
        "\n    <div style=\"display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px 16px;padding:14px 18px;margin-bottom:18px;border-radius:16px;border:1px solid var(--line2);background:rgba(167,141,120,.14)\"><span style=\"font:400 13.5px/1.5 Switzer,sans-serif;color:var(--ink2)\">This is a preview. For a real match against our catalogue, open the Finder.</span><a href=\"/finder\" style=\"flex:none;height:40px;padding:0 18px;border-radius:999px;border:1px solid var(--ink);background:var(--ink);color:#E1D4C2;font:500 13px/1 Switzer,sans-serif;text-decoration:none;display:inline-flex;align-items:center;white-space:nowrap\">Open the Finder</a></div>\n    "
      ]
    }
  ]
}
