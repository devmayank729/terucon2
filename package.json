{
  "name": "terucon",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Terucon: the website, Materials shop and client dashboard (Express), with the Design Studio (Swatchroom, kept in swatchroom/) mounted in the same server.",
  "main": "app.js",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "swatchroom"
  ],
  "scripts": {
    "start": "node app.js",
    "prestart": "node tools/build-site.js --if-missing",
    "dev": "node --watch-path=server --watch-path=swatchroom/server --watch-path=app.js app.js",
    "build:site": "node tools/build-site.js",
    "check:site": "node tools/build-site.js --check",
    "check:links": "node tools/check-links.js",
    "build:overview": "node tools/build-overview.js",
    "test": "node tools/run-tests.js",
    "test:js": "node tools/run-tests.js --only js",
    "test:e2e": "node tests/e2e/run.mjs",
    "models": "npm run models -w swatchroom",
    "test:swatchroom": "npm test -w swatchroom"
  },
  "dependencies": {
    "express": "^5.1.0"
  }
}
