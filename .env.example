# =============================================================================
#  Terucon website settings
#
#  Copy this file to ".env" (next to package.json) and start the site with:   npm start
#
#  - .env is private: it is git-ignored and the server never serves it.
#  - These are the WEBSITE's settings: where it listens, and the studio wake-up.
#    The Design Studio has its own settings file, swatchroom/.env (copy
#    swatchroom/.env.example): the database, the Google key and the GPU services
#    are there.
#  - You can edit .env while the server runs; only HOST and PORT need a restart.
#  - A variable set in your terminal (export NAME=...) wins over this file.
#  - TERUCON_ENV_FILE=/path/to/other.env makes the server read a different file
#    (the tests use this so they never touch your real settings).
# =============================================================================


# -----------------------------------------------------------------------------
#  1. Where the server listens
# -----------------------------------------------------------------------------
# 127.0.0.1 = only this computer. Use 0.0.0.0 only where the site must be reachable
# from the network (a server): then anyone who can reach it can open the Design
# Studio, which spends your Google project: see section 3 for what protects it.
HOST=127.0.0.1
PORT=8080
# Extra host names you open the site under (only when it is served from a domain).
# ALLOWED_HOSTS=www.example.com


# -----------------------------------------------------------------------------
#  2. The Design Studio's cold start
# -----------------------------------------------------------------------------
# The studio's GPU services (on Modal) scale to zero when nobody uses them, and a
# sleeping one takes 10-45 seconds to wake. "on" (the default): the website starts
# them as soon as the landing page or the studio page opens, so they are usually
# ready by the time a photo is scanned. A started service is billed until it has
# been idle for a few minutes, even for a visitor who never uploads a photo.
# "off": the studio wakes them only when a photo is scanned, as it does on its own.
STUDIO_WARMUP=on
# The studio's instant preview (the 3D draw of a finish on your photo, in the browser) is served from improved copies of 8 of the studio's own
# files (lighting, soft edges and sharper floors, a level-camera guess for floors, ceilings and head-on walls, fewer tile seams): site/overlays/studio/.
# swatchroom/ itself is not changed. "off": the studio's own files are used instead, to compare or to roll back; saving this file is enough,
# and a browser shows the other version on its next load. The whole story: docs/DESIGN_STUDIO_ARCHITECTURE.md, section 12.
STUDIO_PREVIEW_OVERLAY=on

# Which landing page the address "/" shows.
#   new      (default) the new landing page: built in memory from site/landing/ when the server starts, served pre-compressed (br / gzip)
#            with a strong ETag, its pictures, fonts and script under /lp/ for a year (immutable). README, "The landing page".
#   classic  the earlier landing page (pages/home.html, the site map's "home" page). Saving this file is enough: no restart. A LANDING set in the real environment (for instance on Render) is read when the server starts: change it there and the service has to restart (how Render does that on saving a variable is not verified here).
# Anything else counts as "new". Leave it out unless you need the earlier page back.
LANDING=new


# -----------------------------------------------------------------------------
#  3. Keeping the open studio safe
# -----------------------------------------------------------------------------
# The studio has no passcode: the website switches the studio's own STUDIO_PASSCODE
# (swatchroom/.env) off, whatever it says, so visitors from the landing page can just
# use it. "on": keep the studio's passcode; then the protections below are not used.
# Takes effect when the server starts.
STUDIO_REQUIRE_PASSCODE=off
# With the passcode off, each browser can only see, open and delete the rooms it made
# itself, and these limits (requests per hour, per browser) stop a stranger running up
# the Google / GPU bill or filling the database. The same limits times the factor apply
# to one network address (an office or a phone network shares one). These are starting
# values chosen by whoever set the site up, not measured: change them if real visitors hit them.
# (These are the starting values: once the admin saves a limit in the admin API (settings
# studio.limit.*, section 5) that value wins.)
# STUDIO_LIMIT_AI=60          Gemini calls (renders, outlines)
# STUDIO_LIMIT_VISION=60      photo scans
# STUDIO_LIMIT_PIPELINE=40    room analysis and its wake-ups
# STUDIO_LIMIT_CHECK=10       Settings > Check (tests Google and the models)
# STUDIO_LIMIT_ROOMS=600      saving and deleting rooms and their files (autosave is frequent)
# STUDIO_LIMIT_ADDRESS_FACTOR=4
# How many proxies sit in front of the site (Render: 1). Without this the site sees the
# proxy's address instead of the visitor's, so the per-address limit and HTTPS detection
# (HSTS, secure cookies) do not work behind one. 'loopback' (the default) is right when
# the site is opened directly.
# TRUST_PROXY=1


# -----------------------------------------------------------------------------
#  4. Analytics (PostHog)
# -----------------------------------------------------------------------------
# Every page, and the studio, send page views, clicks and forms to PostHog once there is
# a project key. Left blank, the studio's own POSTHOG_KEY (swatchroom/.env) is used, so
# the pages and the studio land in one project. A browser that sends Do Not Track is not
# recorded. Session replay masks all text and fields and blocks photos.
# POSTHOG_KEY=phc_your_project_api_key
# POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_REPLAY=on
# Nothing is sent while the site is opened as localhost, so your own test clicks do not
# fill the real project. "on" to test the analytics from your own computer.
# POSTHOG_ON_LOCALHOST=off


# -----------------------------------------------------------------------------
#  5. Sign-in and accounts
# -----------------------------------------------------------------------------
# Every page but the landing page needs an account, and so do the Design Studio's costly
# and private routes. People sign in with a one-time code sent to an e-mail address or a
# mobile number, or with Google. The rate limits and the other adjustable rules are NOT in
# this file: they are in the database and are changed through the admin API (README,
# "Sign-in, accounts and the CRM"). This file holds the keys and what decides whether the
# site is safe to run at all. If the sign-in cannot run safely it does not run, and the
# banner and /api/health say why.
#
# on (the default): the gate is up. off: development only, every page is open. Read at start-up.
AUTH_REQUIRED=on
# 32 or more random characters, for example:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Keys the one-time codes. Without it nobody can sign in (on this computer a temporary one is
# made, so sign-ins end at every restart).
# AUTH_SECRET=
# 32 or more random characters. The bearer token for the admin API (rate limits, settings, the
# security log, the CRM queue). Not set: that API does not exist.
# AUTH_ADMIN_TOKEN=
# Where accounts are kept: auto (the studio's MongoDB when the studio is mounted, else memory,
# which is lost at restart), memory, or mongo. Read at start-up.
# AUTH_STORE=auto
# auto: the cookie is Secure (named __Host-terucon_session) on an HTTPS request. Behind Render
# set TRUST_PROXY=1 (section 3) so HTTPS is recognised, and so every visitor is not one address.
# AUTH_COOKIE_SECURE=auto

# --- e-mail codes: off, smtp, or console (development only: prints the code in this window;
# refused unless the server listens on this computer only and NODE_ENV is not "production").
# Left out, it is "auto": the console on this computer (so `npm start` works while you try the
# site; the codes appear in this window) and nothing on a server.
# AUTH_EMAIL_PROVIDER=smtp
# Plain ASCII, on a domain your mail service has verified:  Terucon <no-reply@your-domain>
# AUTH_EMAIL_FROM=
# Zoho Mail: smtp.zoho.in, 465 (tls) or 587 (starttls). Any SMTP service works.
# AUTH_SMTP_HOST=smtp.zoho.in
# AUTH_SMTP_PORT=465
# tls (465), starttls (587), or none (this computer only). Certificates are always checked.
# AUTH_SMTP_SECURE=tls
# AUTH_SMTP_USER=
# AUTH_SMTP_PASS=

# --- text-message codes: off, twilio, webhook, or console (development only). Left out: "auto", as above.
# webhook sends {to, message, code, purpose, minutes} as JSON to your own URL, which hands it to
# whatever gateway you use (MSG91, Fast2SMS ...). Which countries may get a text is a setting in
# the admin API (sms.allowedCountryCodes, default 91 only) and a daily ceiling is another.
# AUTH_SMS_PROVIDER=twilio
# For India the text usually has to match one registered with the operator. {code} is required.
# AUTH_SMS_TEMPLATE={code} is your Terucon verification code. It works for {minutes} minutes. Do not share it with anyone.
# AUTH_TWILIO_ACCOUNT_SID=
# AUTH_TWILIO_AUTH_TOKEN=
# AUTH_TWILIO_FROM=
# AUTH_TWILIO_MESSAGING_SERVICE_SID=
# AUTH_SMS_WEBHOOK_URL=
# AUTH_SMS_WEBHOOK_TOKEN=

# --- Google One Tap and the Google button. The client id is not secret. Create an OAuth client
# (type: Web application) in Google Cloud and add this site's address (https://your-domain, and
# http://localhost:8080 to try it here) under "Authorised JavaScript origins".
# AUTH_GOOGLE_CLIENT_ID=596545678170-2c7aoic48gke8jahng536kpd9dk9didl.apps.googleusercontent.com


# -----------------------------------------------------------------------------
#  6. CRM (Zoho)
# -----------------------------------------------------------------------------
# A finished sign-up (name, e-mail, phone, firm) is queued and sent to Zoho CRM in the
# background, retried when Zoho is slow or down. With the Zoho settings below left blank
# nothing is lost: sign-ups wait in the queue and are sent once they are filled in.
# Which module (Leads or Contacts), the field names and more are settings in the admin API.
# zoho (the default) or off.
AUTH_CRM=zoho
# Your data centre: in (India), com, eu, com.au, jp, ca, com.cn. Or give ZOHO_ACCOUNTS_URL.
# ZOHO_DC=in
# ZOHO_ACCOUNTS_URL=
# From api-console.zoho.in (a "Self Client"). The refresh token needs the scope ZohoCRM.modules.ALL.
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=


# -----------------------------------------------------------------------------
#  7. Inspiration import (paste a link, crop, send to the Design Studio)
# -----------------------------------------------------------------------------
# A pasted address is read by gallery-dl (python/gallery_resolve.py) for the sites in site/inspiration/sources.js, directly for a
# link to a picture file, and by the page's own named picture for any other web page. Set up gallery-dl once, from the project folder:
#     python3 -m venv python/.venv && python/.venv/bin/pip install -r python/requirements.txt
# Without it picture links and web pages still work; the sites that need gallery-dl say "not set up". Takes effect on the next request.
# on (the default) or off.
# INSPIRATION_IMPORT=on
# Most pictures taken from a board or album (1 to 100).
# INSPIRATION_LIMIT=40
# Seconds to wait for gallery-dl (10 to 180).
# INSPIRATION_TIMEOUT_SECONDS=60
# The biggest picture taken, in megabytes (1 to 50). Pictures over 64 million pixels are refused whatever their size.
# INSPIRATION_MAX_FILE_MB=25
# Where the Python and the script are, if they are not python/.venv/bin/python and python/gallery_resolve.py.
# IMPORTER_PYTHON=
# IMPORTER_SCRIPT=


# -----------------------------------------------------------------------------
#  8. Catalogue (Finder, catalogue admin: match a photo to the real materials)
# -----------------------------------------------------------------------------
# The whole set-up, step by step: docs/CATALOGUE_SETUP.md. These are read from THIS file (the root .env), not from swatchroom/.env.
# With none of them set the catalogue is simply off: /finder says so and the shop keeps its colour demo. Takes effect on the next request.
# The catalogue admin page also needs AUTH_ADMIN_TOKEN (section 5); without it the admin API does not exist (404).
# on (the default) or off.
# CATALOGUE=on
# The two web addresses that `modal deploy modal_app.py` (run in catalogue/) prints. https only; no password, query or fragment in them.
# CATALOGUE_MODAL_SEARCH_URL=
# CATALOGUE_MODAL_INGEST_URL=
# ONE of the API_KEYS of the Modal secret terucon-catalogue-keys (8 to 512 visible characters, no spaces).
# CATALOGUE_MODAL_KEY=
# Only if you deployed with CATALOGUE_REQUIRE_PROXY_AUTH=1: a Modal proxy-auth token pair. Both or neither.
# CATALOGUE_MODAL_PROXY_KEY=
# CATALOGUE_MODAL_PROXY_SECRET=
# Milliseconds to wait for Modal (200 to 300000). A cold start takes tens of seconds; the page asks again.
# CATALOGUE_MODAL_TIMEOUT_MS=60000
# The Google Cloud bucket and the folder inside it. The same values as in the Modal secret terucon-catalogue-gcp.
# CATALOGUE_GCS_BUCKET=
# CATALOGUE_GCS_PREFIX=catalogue/
# The service-account JSON key that only SIGNS picture and upload links (a separate, least-privilege account: read and create on that one
# bucket), pasted RIGHT HERE as text: no file is kept on the server. Put the whole downloaded file between SINGLE quotes (not double
# quotes: they break the key's line breaks), on one line or as downloaded:
#   CATALOGUE_GCS_KEY_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...", ...}'
# or as base64, with no quotes (macOS: base64 -i the-key.json | tr -d '\n'):
#   CATALOGUE_GCS_KEY_JSON=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Iiwi...
# On Render: add it as an environment variable in the dashboard and paste the file's text (or the base64) as the value, with no quotes.
# This file (.env) is ignored by git, so it is never uploaded to GitHub; keep it that way.
# CATALOGUE_GCS_KEY_JSON=
# Only if you would rather keep the key as a file: a PATH to that JSON file. If both are set, CATALOGUE_GCS_KEY_JSON is used.
# CATALOGUE_GCS_KEY_FILE=
# balanced (the default since 2026-11-04: DINOv2 + SigLIP + colour + the Vertex AI image embedding, which knows wood from stone), fast (without the Vertex
# signal: a pale wooden floor came back as concrete and marble) or full (also a Gemini description of the photo: about 5 s and a Gemini call more per search,
# not better on the test set). An explicit value here, or on Render, wins over the default. Numbers: catalogue/ARCHITECTURE.md section 5.1.
# CATALOGUE_SEARCH_PROFILE=balanced


# -----------------------------------------------------------------------------
#  9. TeruBot (the assistant on every page)
# -----------------------------------------------------------------------------
# A chat assistant (Gemini on Google's Vertex AI) that knows the shop's materials and the site's pages, and can open pages, fill the cart or
# the Saved list, and pre-fill the enquiry form IN THE VISITOR'S BROWSER. It uses the Design Studio's Google connection, so there is nothing
# to add here for that: set GOOGLE_APPLICATION_CREDENTIALS (or GOOGLE_SERVICE_ACCOUNT_JSON) and VERTEX_LOCATION in swatchroom/.env, or in the
# real environment on the server, as for the studio. Without a Google key TeruBot says it is not set up (the rest of the site is untouched).
# Takes effect on the next request. Limits are per hour and live in memory, so a restart clears them. Every message can cost several model
# calls, and anybody can open the landing page, so these start low: raise them when real visitors hit them.
# on (the default) or off.
# TERUBOT=on
# Blank: the first model of the studio's text model list (it falls back to the next when a model is not available in your project).
# TERUBOT_MODEL=
# Longest answer, in model tokens (128 to 4096).
# TERUBOT_MAX_OUTPUT_TOKENS=1024
# How many of the latest messages of a conversation the model reads (2 to 20; the widget sends at most 12).
# TERUBOT_HISTORY_LIMIT=12
# How many rounds of look-ups one answer may take (1 to 6).
# TERUBOT_TOOL_ROUNDS=4
# Seconds before an answer is given up on (1 to 120), tool rounds included.
# TERUBOT_TIMEOUT_SECONDS=30
# Messages per hour: per signed-in account / per network address (signed in or not) / per address for visitors who are not signed in.
# TERUBOT_LIMIT_ACCOUNT=60
# TERUBOT_LIMIT_ADDRESS=120
# TERUBOT_LIMIT_ANONYMOUS=20
# The voice that speaks the answers in a live ("Talk") conversation: Google Cloud Text-to-Speech, Chirp 3 HD, in Indian English and in Hindi
# (also for Hinglish, which is Hindi written in Roman letters). One name, the same speaker in both languages. It uses the same Google key as the
# chat, so the Cloud Text-to-Speech API must be enabled in that Google Cloud project (a one-time switch in the Google Cloud console); billed by
# Google per character spoken. "off": no Google voice, the browser's own voice is used. Names: Aoede (the default), Kore, Leda, Sulafat,
# Achernar, Zephyr, Puck, Charon, Orus, Fenrir and others on Google's Chirp 3 HD list (node tools/voice-samples.mjs makes a clip of each to listen to).
# TERUBOT_VOICE=Aoede

# -----------------------------------------------------------------------------
#  10. Capture from a phone (a QR code or a WhatsApp link; photos come back to the person who asked)
# -----------------------------------------------------------------------------
# On the Design Studio, Inspiration and Finder pages a "Photos from phone" button makes a link. Somebody with a phone opens it (from a QR code or
# a WhatsApp message), takes or chooses photos, adds labels, who they are and (with a button) where they are, and sends them. The photos appear for
# the person who asked, who can move one to the studio, Inspiration or the Finder. Photos are kept in the studio's MongoDB (the same database as the
# rooms), not in a bucket, and the database deletes them after CAPTURE_KEEP_DAYS. How it works and what is checked: docs/CAPTURE_FROM_PHONE.md.
# Takes effect on the next request (CAPTURE_STORE: at start-up).
# on (the default) or off.
# CAPTURE=on
# auto (the studio's MongoDB when there is one), mongo, or memory (no database: photos are lost at every restart; development only).
# CAPTURE_STORE=auto
# THE address a phone opens, for the QR code and the WhatsApp message, for example https://your-site.example (https; no path). Left out, Render's own
# RENDER_EXTERNAL_URL is used. It is never read from a request's Host header, except on this computer, where the panel says a phone cannot open it.
# Set it when the site has its own domain.
# CAPTURE_PUBLIC_URL=
# How long a link works, minutes (5 to 1440); photos a link takes (1 to 100); the biggest photo the server takes, MB (1 to 10; the phone shrinks
# photos to about 1 MB first); days before photos are deleted (1 to 365).
# CAPTURE_SESSION_MINUTES=120
# CAPTURE_MAX_PHOTOS=30
# CAPTURE_MAX_PHOTO_MB=6
# CAPTURE_KEEP_DAYS=30
# Added to a number typed without a country code.
# CAPTURE_DEFAULT_COUNTRY_CODE=91
# Limits per hour: new links per account; photos per network address (a phone network shares addresses); WhatsApp messages the server sends per account (0 = never).
# CAPTURE_LIMIT_SESSIONS=20
# CAPTURE_LIMIT_UPLOADS=300
# CAPTURE_LIMIT_WHATSAPP=10
# WhatsApp from the server is OPTIONAL and needs a Meta business account, a business number and templates Meta has approved. Without it the link is
# sent through the requester's OWN WhatsApp (wa.me: it opens with the number and message ready, the requester presses send) and there is no WhatsApp
# alert when a photo arrives; the pop-up on the page works either way. Nothing here has been run against Meta's servers.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v23.0
# The approved templates (the text to submit is in server/capture/whatsapp.js and docs/CAPTURE_FROM_PHONE.md). PHOTO: "who sent how many photos for which page"
# (alerts to the requester). LINK: sends the link to a number. Each is optional on its own.
# WHATSAPP_TEMPLATE_PHOTO=
# WHATSAPP_TEMPLATE_LINK=
# WHATSAPP_TEMPLATE_LANG=en
