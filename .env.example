# =============================================================================
#  Terucon website settings
#
#  Copy this file to ".env" (next to package.json) and start the site with:   npm start
#
#  - .env is private: it is git-ignored and the server never serves it.
#  - These are the WEBSITE's settings: where it listens, and the studio wake-up.
#    The Design Studio has its own settings file, swatchroom/.env (copy
#    swatchroom/.env.example): the database, the Google key and the GPU services
#    are there.
#  - You can edit .env while the server runs; only HOST and PORT need a restart.
#  - A variable set in your terminal (export NAME=...) wins over this file.
#  - TERUCON_ENV_FILE=/path/to/other.env makes the server read a different file
#    (the tests use this so they never touch your real settings).
# =============================================================================


# -----------------------------------------------------------------------------
#  1. Where the server listens
# -----------------------------------------------------------------------------
# 127.0.0.1 = only this computer. Use 0.0.0.0 only where the site must be reachable
# from the network (a server): then anyone who can reach it can open the Design
# Studio, which spends your Google project: see section 3 for what protects it.
HOST=127.0.0.1
PORT=8080
# Extra host names you open the site under (only when it is served from a domain).
# ALLOWED_HOSTS=www.example.com


# -----------------------------------------------------------------------------
#  2. The Design Studio's cold start
# -----------------------------------------------------------------------------
# The studio's GPU services (on Modal) scale to zero when nobody uses them, and a
# sleeping one takes 10-45 seconds to wake. "on" (the default): the website starts
# them as soon as the landing page or the studio page opens, so they are usually
# ready by the time a photo is scanned. A started service is billed until it has
# been idle for a few minutes, even for a visitor who never uploads a photo.
# "off": the studio wakes them only when a photo is scanned, as it does on its own.
STUDIO_WARMUP=on


# -----------------------------------------------------------------------------
#  3. Keeping the open studio safe
# -----------------------------------------------------------------------------
# The studio has no passcode: the website switches the studio's own STUDIO_PASSCODE
# (swatchroom/.env) off, whatever it says, so visitors from the landing page can just
# use it. "on": keep the studio's passcode; then the protections below are not used.
# Takes effect when the server starts.
STUDIO_REQUIRE_PASSCODE=off
# With the passcode off, each browser can only see, open and delete the rooms it made
# itself, and these limits (requests per hour, per browser) stop a stranger running up
# the Google / GPU bill or filling the database. The same limits times the factor apply
# to one network address (an office or a phone network shares one). These are starting
# values chosen by whoever set the site up, not measured: change them if real visitors hit them.
# (These are the starting values: once the admin saves a limit in the admin API (settings
# studio.limit.*, section 5) that value wins.)
# STUDIO_LIMIT_AI=60          Gemini calls (renders, outlines)
# STUDIO_LIMIT_VISION=60      photo scans
# STUDIO_LIMIT_PIPELINE=40    room analysis and its wake-ups
# STUDIO_LIMIT_CHECK=10       Settings > Check (tests Google and the models)
# STUDIO_LIMIT_ROOMS=600      saving and deleting rooms and their files (autosave is frequent)
# STUDIO_LIMIT_ADDRESS_FACTOR=4
# How many proxies sit in front of the site (Render: 1). Without this the site sees the
# proxy's address instead of the visitor's, so the per-address limit and HTTPS detection
# (HSTS, secure cookies) do not work behind one. 'loopback' (the default) is right when
# the site is opened directly.
# TRUST_PROXY=1


# -----------------------------------------------------------------------------
#  4. Analytics (PostHog)
# -----------------------------------------------------------------------------
# Every page, and the studio, send page views, clicks and forms to PostHog once there is
# a project key. Left blank, the studio's own POSTHOG_KEY (swatchroom/.env) is used, so
# the pages and the studio land in one project. A browser that sends Do Not Track is not
# recorded. Session replay masks all text and fields and blocks photos.
# POSTHOG_KEY=phc_your_project_api_key
# POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_REPLAY=on
# Nothing is sent while the site is opened as localhost, so your own test clicks do not
# fill the real project. "on" to test the analytics from your own computer.
# POSTHOG_ON_LOCALHOST=off


# -----------------------------------------------------------------------------
#  5. Sign-in and accounts
# -----------------------------------------------------------------------------
# Every page but the landing page needs an account, and so do the Design Studio's costly
# and private routes. People sign in with a one-time code sent to an e-mail address or a
# mobile number, or with Google. The rate limits and the other adjustable rules are NOT in
# this file: they are in the database and are changed through the admin API (README,
# "Sign-in, accounts and the CRM"). This file holds the keys and what decides whether the
# site is safe to run at all. If the sign-in cannot run safely it does not run, and the
# banner and /api/health say why.
#
# on (the default): the gate is up. off: development only, every page is open. Read at start-up.
AUTH_REQUIRED=on
# 32 or more random characters, for example:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Keys the one-time codes. Without it nobody can sign in (on this computer a temporary one is
# made, so sign-ins end at every restart).
# AUTH_SECRET=
# 32 or more random characters. The bearer token for the admin API (rate limits, settings, the
# security log, the CRM queue). Not set: that API does not exist.
# AUTH_ADMIN_TOKEN=
# Where accounts are kept: auto (the studio's MongoDB when the studio is mounted, else memory,
# which is lost at restart), memory, or mongo. Read at start-up.
# AUTH_STORE=auto
# auto: the cookie is Secure (named __Host-terucon_session) on an HTTPS request. Behind Render
# set TRUST_PROXY=1 (section 3) so HTTPS is recognised, and so every visitor is not one address.
# AUTH_COOKIE_SECURE=auto

# --- e-mail codes: off, smtp, or console (development only: prints the code in this window;
# refused unless the server listens on this computer only and NODE_ENV is not "production").
# Left out, it is "auto": the console on this computer (so `npm start` works while you try the
# site; the codes appear in this window) and nothing on a server.
# AUTH_EMAIL_PROVIDER=smtp
# Plain ASCII, on a domain your mail service has verified:  Terucon <no-reply@your-domain>
# AUTH_EMAIL_FROM=
# Zoho Mail: smtp.zoho.in, 465 (tls) or 587 (starttls). Any SMTP service works.
# AUTH_SMTP_HOST=smtp.zoho.in
# AUTH_SMTP_PORT=465
# tls (465), starttls (587), or none (this computer only). Certificates are always checked.
# AUTH_SMTP_SECURE=tls
# AUTH_SMTP_USER=
# AUTH_SMTP_PASS=

# --- text-message codes: off, twilio, webhook, or console (development only). Left out: "auto", as above.
# webhook sends {to, message, code, purpose, minutes} as JSON to your own URL, which hands it to
# whatever gateway you use (MSG91, Fast2SMS ...). Which countries may get a text is a setting in
# the admin API (sms.allowedCountryCodes, default 91 only) and a daily ceiling is another.
# AUTH_SMS_PROVIDER=twilio
# For India the text usually has to match one registered with the operator. {code} is required.
# AUTH_SMS_TEMPLATE={code} is your Terucon verification code. It works for {minutes} minutes. Do not share it with anyone.
# AUTH_TWILIO_ACCOUNT_SID=
# AUTH_TWILIO_AUTH_TOKEN=
# AUTH_TWILIO_FROM=
# AUTH_TWILIO_MESSAGING_SERVICE_SID=
# AUTH_SMS_WEBHOOK_URL=
# AUTH_SMS_WEBHOOK_TOKEN=

# --- Google One Tap and the Google button. The client id is not secret. Create an OAuth client
# (type: Web application) in Google Cloud and add this site's address (https://your-domain, and
# http://localhost:8080 to try it here) under "Authorised JavaScript origins".
# AUTH_GOOGLE_CLIENT_ID=


# -----------------------------------------------------------------------------
#  6. CRM (Zoho)
# -----------------------------------------------------------------------------
# A finished sign-up (name, e-mail, phone, firm) is queued and sent to Zoho CRM in the
# background, retried when Zoho is slow or down. With the Zoho settings below left blank
# nothing is lost: sign-ups wait in the queue and are sent once they are filled in.
# Which module (Leads or Contacts), the field names and more are settings in the admin API.
# zoho (the default) or off.
AUTH_CRM=zoho
# Your data centre: in (India), com, eu, com.au, jp, ca, com.cn. Or give ZOHO_ACCOUNTS_URL.
# ZOHO_DC=in
# ZOHO_ACCOUNTS_URL=
# From api-console.zoho.in (a "Self Client"). The refresh token needs the scope ZohoCRM.modules.ALL.
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=


# -----------------------------------------------------------------------------
#  7. Inspiration import (paste a link, crop, send to the Design Studio)
# -----------------------------------------------------------------------------
# A pasted address is read by gallery-dl (python/gallery_resolve.py) for the sites in site/inspiration/sources.js, directly for a
# link to a picture file, and by the page's own named picture for any other web page. Set up gallery-dl once, from the project folder:
#     python3 -m venv python/.venv && python/.venv/bin/pip install -r python/requirements.txt
# Without it picture links and web pages still work; the sites that need gallery-dl say "not set up". Takes effect on the next request.
# on (the default) or off.
# INSPIRATION_IMPORT=on
# Most pictures taken from a board or album (1 to 100).
# INSPIRATION_LIMIT=40
# Seconds to wait for gallery-dl (10 to 180).
# INSPIRATION_TIMEOUT_SECONDS=60
# The biggest picture taken, in megabytes (1 to 50). Pictures over 64 million pixels are refused whatever their size.
# INSPIRATION_MAX_FILE_MB=25
# Where the Python and the script are, if they are not python/.venv/bin/python and python/gallery_resolve.py.
# IMPORTER_PYTHON=
# IMPORTER_SCRIPT=
