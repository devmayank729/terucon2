# =============================================================================
#  Terucon server settings
#
#  Copy this file to ".env" (next to package.json), paste your credentials below,
#  save, and start the site with:   npm start
#
#  - .env is private: it is git-ignored and the server never serves it.
#  - The browser never sees any of these values. Your pages talk to the Express
#    server, and the server (and its Python model service) talk to Google.
#  - Both the Express server and the Python model service read this one file.
#  - You can edit .env while the server runs: reload the page and it is picked up.
#    (Only HOST, PORT and the MODEL_* settings in section 6 need a restart.)
#  - A variable set in your terminal (export NAME=...) wins over this file.
#  - TERUCON_ENV_FILE=/path/to/other.env makes both programs read a different file
#    (the tests use this so they never touch your real credentials).
# =============================================================================


# -----------------------------------------------------------------------------
#  1. Where the server listens
# -----------------------------------------------------------------------------
# 127.0.0.1 = only this computer. Use 0.0.0.0 ONLY on a trusted network: anyone
# who can reach the server could then use your Google credentials.
HOST=127.0.0.1
PORT=8080
# Extra host names you open the site under (only when it is served from a domain).
# ALLOWED_HOSTS=studio.example.com


# -----------------------------------------------------------------------------
#  2. Google Cloud   (needed for surface detection and renders in the Design Studio)
#
#  Pick ONE way to sign in. The variable names match terucon_backend/.env, so you
#  can paste the same values across.
# -----------------------------------------------------------------------------

# --- Option A (recommended): a service-account key for Vertex AI ---------------
# 1. Cloud console > IAM > Service accounts > create one, give it the role
#    "Vertex AI User" (roles/aiplatform.user).
# 2. Keys > Add key > JSON. Open the downloaded file.
# 3. Paste the WHOLE file on ONE line, inside SINGLE quotes:
#      GCP_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"..."}'
#    (Single quotes matter: they keep the \n inside the private key intact.)
# 4. Also enable the Vertex AI API (aiplatform.googleapis.com) and billing on the project.
GCP_SERVICE_ACCOUNT_JSON=

# ...or, instead of pasting, point at the key file (absolute path, or relative to this folder):
GOOGLE_APPLICATION_CREDENTIALS=

# The project id, e.g. my-project-123 (a short name, NOT the key). Blank = taken from the key.
GOOGLE_CLOUD_PROJECT=
# "global" is right for the Nano Banana models. Other choices: us-central1, asia-south1, ...
GOOGLE_CLOUD_LOCATION=global

# --- Option B: a Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
# Simpler to get, but it is the Gemini API rather than your Cloud project. Leave A blank to use it.
GEMINI_API_KEY=
# true = Vertex AI with the service account, false = the API key. Blank = pick whichever is filled in.
GOOGLE_GENAI_USE_VERTEXAI=


# -----------------------------------------------------------------------------
#  3. Models (leave blank to use the Design Studio's defaults; each is also
#     changeable in the studio's Settings. A value here wins over the studio.)
#     If a model is not available to your project, the next newer/older one is tried automatically.
# -----------------------------------------------------------------------------
# Renders ("Nano Banana"):
SWATCHROOM_IMAGE_MODEL=
# Finds and outlines the surfaces in a photo (needs structured output + vision):
SWATCHROOM_DETECT_MODEL=
# Optional pixel-mask model for the older "Gemini only" engine (gemini-2.5-flash retires 20 Oct 2026):
SWATCHROOM_MASK_MODEL=
# Quantity / material take-off estimates:
SWATCHROOM_INSIGHT_MODEL=


# -----------------------------------------------------------------------------
#  4. How surfaces are found
# -----------------------------------------------------------------------------
# auto   = Gemini (above) finds and names the surfaces, edge snapping aligns them with the photo's edges
#          (and SAM corrects the outlines first, if it is on); the in-browser parser is the fallback.   (recommended)
# scene  = only the in-browser scene parser (no Google, lower accuracy, works offline)
# gemini = only Gemini in the browser (the old engine)
SEGMENTATION_ENGINE=auto
# Snap the outlines (and SAM's edges) onto the photo's real edges.
EDGE_REFINE=true
# contour   = slide each boundary onto the nearest convincing edge, paying for every pixel it moves (recommended)
# watershed = the earlier method, kept as a fallback if contour snapping ever misbehaves on your photos
EDGE_METHOD=contour
# Detection resolution in pixels (the studio offers up to 1536). Higher = finer edges, slower.
ANALYSIS_MAX_SIDE=1536


# -----------------------------------------------------------------------------
#  5. SAM  (OPTIONAL: sharper edges. Everything works without it.)
#
#  Easiest: SAM 2.1 on this computer's CPU.
#    pip install -r model/requirements-sam.txt      (PyTorch + transformers, ~2 GB)
#    SAM_ENABLED=true
#  The model (~180 MB) downloads the first time; the server shows "SAM: ready" when it is loaded.
# -----------------------------------------------------------------------------
SAM_ENABLED=false
# auto | sam2 | sam | sam3 | remote
#   sam2   SAM 2 / 2.1 through Hugging Face (boxes + clicks, runs on CPU or GPU)    [default]
#   sam    the original SAM (SAM_MODEL_ID=facebook/sam-vit-base)
#   sam3   Meta SAM 3 (needs a CUDA GPU, see below)
#   remote another server that answers /health, /segment, /refine (see SAM_REMOTE_URL)
#   auto   remote if SAM_REMOTE_URL is set, else sam3 if SAM_CHECKPOINT is set, else sam2
SAM_BACKEND=auto
# tiny is fastest, small is the default, base-plus / large are sharper but slower:
SAM_MODEL_ID=facebook/sam2.1-hiera-small
# auto | cpu | cuda | mps
SAM_DEVICE=auto
# Load the model as soon as the server starts (so the first scan does not wait).
SAM_PRELOAD=true
# A Hugging Face token, needed only for gated models such as facebook/sam3.
HF_TOKEN=

# --- SAM 3 on a GPU machine (text prompts: "wall", "floor", ...) ----------------
# 1. Accept the licence at https://huggingface.co/facebook/sam3 and download sam3.pt with your HF_TOKEN
# 2. git clone https://github.com/facebookresearch/sam3 && pip install -e sam3
# 3. Set SAM_BACKEND=sam3 and the two paths below. Uses the sam3 package's build_sam3_image_model / Sam3Processor.
SAM_CHECKPOINT=
SAM_REPO_DIR=

# --- Use a SAM server running somewhere else (a GPU box, Kaggle, Colab, AWS...) ------------
# Run THIS project on that machine (npm start with SAM_ENABLED=true, HOST=0.0.0.0, SAM_SERVER_KEY=...) and put its address here,
# including /api/sam. Or run only the Python model service there (cd model && python -m terucon_model, with MODEL_HOST=0.0.0.0
# and SAM_SERVER_KEY) and use .../sam. Any server that speaks /health /segment /refine works too.
# SAM_REMOTE_URL=https://gpu-box.example.com:8080/api/sam
SAM_REMOTE_URL=
SAM_REMOTE_KEY=
# bearer | x-api-key
SAM_REMOTE_AUTH_HEADER=bearer
# On the GPU machine: require this key for /api/sam/* (use the same value as SAM_REMOTE_KEY above).
SAM_SERVER_KEY=


# -----------------------------------------------------------------------------
#  6. The Python model service  (finds surfaces in photos; Express starts it for you)
#
#  The website is Express (JavaScript). Everything about the models (Gemini
#  detection, SAM, edge snapping, evaluation, fine-tuning) is Python, in model/,
#  and runs as a small internal service. `npm start` starts it as a child process.
#  The site works without it: the Design Studio then uses its in-browser parser.
#  One-time setup:   npm run setup:model      (pip install -r model/requirements.txt)
# -----------------------------------------------------------------------------
# auto     = Express starts and watches the service (default)
# external = use a service you started yourself; set MODEL_SERVICE_URL
# off      = no model service (Design Studio uses its in-browser detection only)
MODEL_SERVICE=auto
# Only for MODEL_SERVICE=external, e.g. http://127.0.0.1:8081 (or the GPU machine's address)
# MODEL_SERVICE_URL=http://127.0.0.1:8081
# Shared secret between Express and the service. Leave blank in auto mode: a random one is made for each run.
# Set it when the service runs somewhere else and must not accept strangers.
MODEL_SERVICE_KEY=
# The Python to start the service with. Blank = model/.venv, .venv, then python3 / python on your PATH.
PYTHON=
# Seconds to wait for the service to come up before the site carries on without it.
MODEL_START_TIMEOUT=90
# Where the service listens when you run it by hand (npm run model). In auto mode Express picks a free port itself.
MODEL_HOST=127.0.0.1
MODEL_PORT=8081
