# Swatchroom server settings. Copy this file to .env and fill it in.

# ------------------------------------------------------------------ web server
PORT=3000
# HOST=0.0.0.0

# ------------------------------------------------------------------ MongoDB
# Local MongoDB, or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/swatchroom

# ------------------------------------------------------------------ Google (Gemini on Vertex AI)
# Path to the service-account JSON key (relative to this folder, or absolute).
GOOGLE_APPLICATION_CREDENTIALS=keys/swatchroom-key.json
# Or paste the whole JSON key into one line instead:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Project to bill (defaults to the key's project_id).
# GOOGLE_CLOUD_PROJECT=terucon-demo
VERTEX_LOCATION=global
# On Cloud Run / App Engine the server can use its own identity instead of a key file:
# GOOGLE_USE_METADATA_SERVER=true

# ------------------------------------------------------------------ Python model service
# The local scan engine: SegFormer-B5. On an x86 CPU its Linear layers run as INT8 when a timed pass at start-up proves
# that is faster (SCENE_QUANTIZE=off keeps fp32); on Apple Silicon INT8 is slower so it stays fp32; on CUDA fp16.
# SCENE_PRELOAD=b5-quant   # model loaded in the background at boot (b2, b4, b5, b5-quant or off)
# SCENE_B5_MIN_GB=3       # B5 is only loaded when the service may use this much memory (else B4 answers); 0 = never check
MODEL_SERVICE_URL=http://127.0.0.1:8001
# If the model service runs on another machine, set the same secret on both sides.
# MODEL_SERVICE_KEY=change-me

# ------------------------------------------------------------------ the "understand this photo"
# pipeline: three remote models, run once per photo, so every later material swap is instant.
# Leave a URL unset and that model is mocked (PIPELINE_MOCK=auto, the default) so the whole
# pipeline works end to end before you have real endpoints.

# SAM 3: which pixels are which surface, used to score the room's own scan regions (not to
# replace them - see server/lib/pipelineRunner.js). Not a scan engine on its own.
# The URL must be the complete endpoint, including its path (each Modal service gets its own
# full domain, and the adapter posts to this URL as-is - see server/lib/remoteModels/sam3.js).
# SAM3_URL=https://your-workspace--vision-sam3.modal.run/v1/segment
# SAM3_KEY=
# SAM3_AUTH_HEADER=bearer   # or x-api-key

# MoGe-2: the room's 3D shape, in real metres.
# MOGE2_URL=https://your-workspace--vision-moge2.modal.run/v1/geometry
# MOGE2_KEY=
# MOGE2_AUTH_HEADER=bearer   # or x-api-key

# Marigold-IID: splits the photo into colour (albedo) and light (shading) layers.
# MARIGOLD_URL=https://your-workspace--vision-marigold.modal.run/v1/decompose
# MARIGOLD_KEY=
# MARIGOLD_AUTH_HEADER=bearer   # or x-api-key

# ONE POOL FOR EVERYTHING (recommended, see "Modal GPUs" in DEPLOY.md). `modal deploy modalBlueprint.py` also deploys
# "VisionAll": all four models in one container behind one URL, so a photo costs ONE cold start and ONE idle tail
# instead of four. Point these two at it (its URL is printed by the deploy):
#
# OneFormer (Swin-L, ADE20K): the high-accuracy SCAN engine. The scan races it against the local quantized
# SegFormer-B5 and offers its more accurate result ("HD Surface Scan Ready") when it arrives later.
# ONEFORMER_URL=https://your-workspace--vision-all.modal.run/v1/oneformer
# ONEFORMER_KEY=
# ONEFORMER_AUTH_HEADER=bearer   # or x-api-key
# ONEFORMER_TTA=off              # "on": three scales + flip for the semantic map, about 5x the GPU time
#
# Room analysis in ONE request: MoGe-2 depth + Marigold lighting + SAM 3 masks (10 prompts) for one photo. When set,
# SAM3_URL / MOGE2_URL / MARIGOLD_URL below are not used by the pipeline.
# ANALYZE_URL=https://your-workspace--vision-all.modal.run/v1/analyze
# ANALYZE_KEY=
# ANALYZE_AUTH_HEADER=bearer
#
# How the server knows whether a pool is warm WITHOUT calling it (a call to a scaled-to-zero pool boots a billed GPU, so
# opening the page must never make one). Every Modal call goes through this server, so it keeps the clock itself.
# MODAL_SCALEDOWN_S=300          # = SCALEDOWN_S / VISION_SCALEDOWN_S in modalBlueprint.py
# MODAL_WARM_MARGIN_S=20
# VISION_ACTIVE_WARMUP=off       # "on": when the pool looks cold, the page-load gate really pings it (bounded at 9 s).
#                                # That boots a GPU for every visitor who lands cold, even one who never uploads a photo.

# Each of SAM3_URL/MOGE2_URL/MARIGOLD_URL also answers GET <its own domain>/healthz (no path
# suffix) with a Bearer/X-API-Key-authenticated 200 when the service is up - this is what
# Settings > Check and the /api/check endpoint call to test connectivity, e.g.:
#   curl -H "Authorization: Bearer $SAM3_KEY" https://your-workspace--vision-sam3.modal.run/healthz

# If all three are the same Modal deployment (vision_stack.py), SAM3_KEY, MOGE2_KEY and
# MARIGOLD_KEY can all be set to the same value - it defines one shared API_KEYS secret for
# all three services.

# How many photos the pipeline analyses at once (heavy local math, kept off the main thread).
# PIPELINE_CONCURRENCY=2
# "auto" (default), "on" (always mock, useful for tests), or "off" (always call the real URL).
# PIPELINE_MOCK=auto

# Where photos, renders and the pipeline's layers (depth, shading...) are stored.
# "gridfs" (default, inside MongoDB) needs nothing else. "gcs" needs a bucket the server's
# Google key can write to (Storage Object Admin) — the same key already used for Vertex AI.
# STORAGE_DRIVER=gridfs
# GCS_BUCKET=

# ------------------------------------------------------------------ access
# Set a passcode before putting the studio on the internet. Without it anyone who can open
# the page can use (and spend) the Google project.
# STUDIO_PASSCODE=choose-a-long-passcode
# Signs the sign-in cookie; set it so people stay signed in across restarts.
# SESSION_SECRET=a-long-random-string
# SESSION_DAYS=30
# "auto" marks cookies Secure when the request came over https. Use "true" behind https.
# SECURE_COOKIES=auto
# Behind a reverse proxy (nginx, Caddy) that terminates https:
# TRUST_PROXY=1

# ------------------------------------------------------------------ admin dashboard
# public/admin.html, server/routes/admin.js: generation log, live visitor count, model/service
# health. Its own sign-in, independent of STUDIO_PASSCODE above. Defaults to the values below
# when left unset - set them here (or in your hosting platform's dashboard) to change them,
# and do that before sharing the URL with anyone.
# ADMIN_EMAIL=admin@terucon.in
# ADMIN_PASSWORD=admin@123

# ------------------------------------------------------------------ PostHog analytics
# Both the browser (public/js/lib/analytics.js, via GET /api/session) and the server itself
# (server/lib/posthogClient.js) send events when POSTHOG_KEY is set. Leave it blank to disable
# analytics entirely - nothing else needs to change.
# POSTHOG_KEY=phc_your_project_api_key
# POSTHOG_HOST=https://us.i.posthog.com

# ------------------------------------------------------------------ pages and limits
# The Terucon page served at "/" (build it with: npm run terucon-page -- <export.html>).
# TERUCON_PAGE=terucon/Swatchroom.html
# ROOM_LIMIT=200
# AI_BODY_LIMIT=40mb
# FILE_BODY_LIMIT=30mb
