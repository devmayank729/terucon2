# Secrets: never commit. Copy .env.example to .env and paste credentials there.
.env
.env.*
!.env.example
# the Design Studio's browser-test settings: mock-server addresses only, tracked in the studio's own repo
!swatchroom/tests/.env.test

# Service-account keys and local credentials
*.pem
*-key.json
service-account*.json
credentials/

# Python / local runtime
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Model weights and local caches. Anchored to the project root: unanchored, "models/" and "data/" would also hide the
# Design Studio's own source folders (swatchroom/server/models/, swatchroom/public/js/data/) from git.
/models/
.cache/
/data/

# Editor / OS
.DS_Store
.idea/
.vscode/

# JS dependencies and test output
node_modules/
npm-debug.log*
coverage/

# The Flask version of the site that the Express + Python-model split replaced, kept until you delete it
_legacy_python_site/
